# =============================================================================
# Hermes local development environment — EXAMPLE ONLY
# =============================================================================
# Kopyala: cp .env.example .env  → yerel degerleri doldur. .env Git'e
# GIRMEZ (.gitignore). Mevcut lokal docker volume'lariniz onceki yerel
# parolanizla init edilmistir; POSTGRES_PASSWORD'u o mevcut yerel
# degere ayarlarsaniz veriniz aynen calismaya devam eder.
# Buraya ASLA production/cluster degeri yazmayin.
# =============================================================================
POSTGRES_PASSWORD=REQUIRED_LOCAL_VALUE
JWT_SECRET_KEY=REQUIRED_LOCAL_VALUE
